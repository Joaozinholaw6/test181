-- ========================= EXECUÇÃO PRINCIPAL =========================
local mainScreen, autoClickBtn = createMainScreen()

local autoClickActive = false
local clickTask

-- Função que tenta clicar no objeto alvo
local function tryClick()
    local target = workspace:FindFirstChild(TARGET_NAME)
    if target then
        local clickEvent = target:FindFirstChild("Click")
        if clickEvent and clickEvent:IsA("RemoteEvent") then
            clickEvent:FireServer()
        end
    end
end

-- Função de controle do loop de auto‑click
local function toggleAutoClick()
    autoClickActive = not autoClickActive
    if autoClickActive then
        autoClickBtn.Text = "Auto Click ON"
        autoClickBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
        -- Se já houver um loop em execução, não cria outro
        if not clickTask then
            clickTask = task.spawn(function()
                while autoClickActive do
                    tryClick()
                    if MAX_CLICKS > 0 then
                        MAX_CLICKS = MAX_CLICKS - 1
                        if MAX_CLICKS == 0 then
                            autoClickActive = false
                            autoClickBtn.Text = "Auto Click OFF"
                            autoClickBtn.BackgroundColor3 = Color3.fromRGB(99, 102, 241)
                            break
                        end
                    end
                    task.wait(CLICK_INTERVAL)
                end
                clickTask = nil
            end)
        end
    else
        autoClickBtn.Text = "Auto Click OFF"
        autoClickBtn.BackgroundColor3 = Color3.fromRGB(99, 102, 241)
    end
end

autoClickBtn.MouseButton1Click:Connect(toggleAutoClick)

-- Mensagem de inicialização
sendNotification("Auto Click", "Clique no botão para ligar/desligar.", "", 4)

